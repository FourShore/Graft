{
  "name": "@fourshore/graft-review",
  "version": "0.0.3",
  "description": "Claim-first review of Graft changes: a local web view that leads with task, plan and evidence, then a diff grouped by what evidence covers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FourShore/Graft.git"
  },
  "homepage": "https://github.com/FourShore/Graft#readme",
  "bugs": {
    "url": "https://github.com/FourShore/Graft/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "git",
    "version-control",
    "ai-agents",
    "mcp",
    "code-review"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fourshore/graft-core": "0.0.3"
  }
}
