{
  "name": "graft-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Agent-native change records on top of git: every change carries its intent, plan, author agent and evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FourShore/Graft.git"
  },
  "homepage": "https://github.com/FourShore/Graft#readme",
  "bugs": {
    "url": "https://github.com/FourShore/Graft/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/review",
    "packages/cli",
    "packages/capabilities"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/review packages/cli packages/capabilities",
    "typecheck": "tsc -b packages/core packages/review packages/cli packages/capabilities",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "dev:review": "node packages/cli/dist/cli.js review",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
